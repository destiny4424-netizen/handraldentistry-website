# Copy this file to ".env" and fill in your Dhan details.
# Client ID and access token: web.dhan.co > My Profile > Access DhanHQ APIs
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional settings
TIMEFRAME=5            # candle size in minutes: 1, 5, 15, 25 or 60
SCAN_EVERY_MIN=5       # auto-scan: runs 20 s after every 5-min candle closes, 9:15-15:30
BREAKOUT_TF=15         # candle size for HTF key level breakouts
DAYS=5                 # calendar days of candles to analyse
SWING=3                # bars on each side that make a swing high/low
TOP_N=20               # how many stocks to show on each side
PICKS=6                # how many Top Picks to show
MIN_RR=1.5             # Top Picks: minimum reward:risk to target 1
MIN_SETUP_SCORE=55     # Top Picks: order block / breakout score needed to pass the first filter
OI_CHECKS=30           # Top Picks: how many shortlisted stocks to check futures OI for
# SYMBOLS=SBIN,INFY,TCS   # scan only these instead of every F&O stock
# HOST=0.0.0.0            # let your phone on the same Wi-Fi open it (see README)
PORT=8000
