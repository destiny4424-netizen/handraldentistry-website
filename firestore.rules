rules_version = '2';

// Every clinic collection is readable/writable only by a signed-in staff
// account. Accounts are created by the clinic admin (Firebase Console or
// `firebase auth:import`) — there is no public self-signup.
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{id}     { allow read, write: if request.auth != null; }
    match /appointments/{id} { allow read, write: if request.auth != null; }
    match /transactions/{id} { allow read, write: if request.auth != null; }
    match /invoices/{id}     { allow read, write: if request.auth != null; }
    match /attendance/{id}   { allow read, write: if request.auth != null; }
    match /staff/{id}        { allow read, write: if request.auth != null; }
    match /consultants/{id}  { allow read, write: if request.auth != null; }
    match /consultCases/{id} { allow read, write: if request.auth != null; }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
