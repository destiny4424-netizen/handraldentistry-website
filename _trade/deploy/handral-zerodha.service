[Unit]
Description=Handral Trading Desk on Zerodha (second copy of the desk, for a Zerodha account)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=trade
Group=trade
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MT_CLOUD=1
Environment=MT_HOST=127.0.0.1
Environment=MT_BROKER=zerodha
# 3051: the Dhan desk uses 3050, the clinic server 3030, Handral Books 3020 and the scanner 3040.
Environment=MT_PORT=3051
Environment=MT_DATA_DIR=/var/lib/handral-zerodha
# The scanner's settings, so the Screener tab can show its picks (read only; the scanner keeps using the Dhan desk's token).
EnvironmentFile=-/etc/default/orderblock-scanner
# MT_PASSWORD, MT_PUBLIC_URL and MT_PUBLIC_IP (and optionally MT_KITE_API_KEY / MT_KITE_API_SECRET), written by install-zerodha.sh.
EnvironmentFile=-/etc/default/handral-zerodha
ExecStart=/usr/bin/python3 /opt/meridian-trade/repo/_trade/trade.py
Restart=always
RestartSec=3
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/handral-zerodha

[Install]
WantedBy=multi-user.target
