# Port the webhook server listens on
PORT=3000

# Long, random string. Put the same value in every TradingView alert's JSON
# body under "secret" so only your own alerts can trigger real orders.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Delta Exchange API credentials. Create these under Account -> API Keys.
# Grant "Trading" permission only - never enable withdrawal permission on a
# key used by a bot, and restrict it to your server's IP if possible.
DELTA_API_KEY=your-delta-api-key
DELTA_API_SECRET=your-delta-api-secret

# https://api.india.delta.exchange for Delta Exchange India,
# https://api.delta.exchange for Delta Exchange Global.
DELTA_BASE_URL=https://api.india.delta.exchange

# Keep this "true" until you've verified alerts arrive and map to the
# correct product/side/size in the logs. Set to "false" to place real orders.
DRY_RUN=true

# Optional safety cap: reject any order whose size is larger than this.
# Leave blank to disable.
MAX_ORDER_SIZE=

# Optional JSON map from the symbol TradingView sends to the symbol Delta
# Exchange lists it under, e.g. {"BTCUSD":"BTCUSD","XBTUSD":"BTCUSD"}
SYMBOL_MAP={}
