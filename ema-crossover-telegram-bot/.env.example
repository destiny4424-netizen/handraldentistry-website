# Copy this file to .env and fill in real values. Never commit .env.

# --- Delta Exchange ---
# Testnet base URL by default. Switch to https://api.delta.exchange for production.
# Verify the current base URL / endpoint paths against Delta's official API docs
# before going live -- exchange APIs change over time.
DELTA_BASE_URL=https://testnet-api.delta.exchange
# Delta's product symbol, e.g. BTCUSD (perpetual futures). Confirm the exact
# symbol string via GET {DELTA_BASE_URL}/v2/products on your target environment.
DELTA_SYMBOL=BTCUSD
# Candle resolution in minutes as Delta expects it (e.g. 1, 5, 15, 60, 240, 1D)
DELTA_RESOLUTION=15
# API key/secret are only required if you later switch this bot to place real
# orders. Not used by the alerts-only bot, but read here so they're in one place.
DELTA_API_KEY=
DELTA_API_SECRET=

# --- EMA strategy ---
EMA_FAST=20
EMA_SLOW=50
# How many closed candles of history to fetch each poll (must be > EMA_SLOW)
CANDLE_LOOKBACK=200
# How often to poll Delta for new candles, in seconds
POLL_SECONDS=60
# Fractional distance from EMA20 a candle's high/low must reach to count as
# a "touch" (0.0015 = 0.15%). Set to 0 to require an exact touch/cross.
TOUCH_TOLERANCE=0.0015
# After a signal fires, price must close this far away from EMA20 again
# before a new pullback touch in the same trend can re-arm another alert.
REARM_TOLERANCE=0.003

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Misc ---
LOG_FILE=ema_bot.log
